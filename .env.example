# FloodRoute Environment Variable Configuration Template
# Copy this file to .env and configure your AWS credentials and agency settings.
# Security notice: Keep credentials server-side and never commit actual secrets to source control.

# --- Core Server Settings ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Amazon Bedrock AI Integration ---
# Primary region for Indian Municipal Mobility: ap-south-1 (Mumbai)
AWS_REGION=ap-south-1

# Recommended Bedrock Model IDs available in ap-south-1:
# - anthropic.claude-3-haiku-20240307-v1:0 (Default fast & structured)
# - anthropic.claude-3-sonnet-20240229-v1:0
# - amazon.titan-text-express-v1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Operational AI Provider & Simulation Safeguard
AI_PROVIDER=bedrock
SIMULATION_MODE=true

# Optional: IAM Credentials for local development if not using 'aws configure' or SSO
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- IMD (India Meteorological Department) API Portal ---
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in/v1

# --- Central Water Commission (CWC) Flood Forecast Services ---
CWC_API_ENDPOINT=https://ffs.india-water.gov.in/api/v1
CWC_AUTH_TOKEN=

# --- MCGM Disaster Management GIS Portal (Mumbai) ---
MCGM_GIS_SERVICE_URL=https://prsrvgisapp.mcgm.gov.in/server/rest/services/mcgm/MCGMGIS_Departments_Master_All_Layers_WGS/MapServer
MCGM_GIS_TOKEN=

# --- Greater Chennai Corporation (GCC) GIS Service ---
GCC_GIS_SERVICE_URL=https://gisgcc.chennaicorporation.gov.in/server/rest/services/GCCDepts/GCC_COLLABORATION_LAYER/MapServer
GCC_GIS_TOKEN=

# --- OpenStreetMap / Map Tiles Provider ---
OSM_TILE_SERVER=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
OSM_GEOCODER_API_KEY=

# --- Cache and Freshness Thresholds (in seconds) ---
SENSOR_FRESHNESS_TTL_SECONDS=1800
FORECAST_FRESHNESS_TTL_SECONDS=10800
HISTORICAL_RISK_CACHE_TTL_SECONDS=86400
